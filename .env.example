# Server
PORT=4000
JWT_SECRET=change_this_to_a_long_random_string

# MySQL (Railway provides these automatically when you add a MySQL plugin)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mijo_field_sales

# Optional: if Railway gives you a single connection URL instead, set this
# and db.js will use it in preference to the individual DB_* vars.
# DATABASE_URL=mysql://user:password@host:port/dbname
