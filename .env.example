# Server
PORT=4000
JWT_SECRET=change_this_to_a_long_random_string

# MySQL (Railway provides these automatically when you add a MySQL plugin)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mijo_field_sales

# Optional: if Railway gives you a single connection URL instead, set this
# and db.js will use it in preference to the individual DB_* vars.
# DATABASE_URL=mysql://user:password@host:port/dbname

# ---- Security settings --------------------------------------------------------------------
# JWT_SECRET above MUST be a long random value (e.g. `openssl rand -hex 32`), never a phrase.
# Starter admin password for a brand-new database. Leave unset to have a random one generated
# and printed once in the deploy logs.
# INITIAL_ADMIN_PASSWORD=
# Other websites allowed to call the API (comma-separated). Leave unset: the web app and the
# mobile app both use this same server, so no other site needs access.
# ALLOWED_ORIGINS=
# The Content-Security-Policy starts in report-only mode (logs, never blocks). Set to true to enforce.
# CSP_ENFORCE=true
